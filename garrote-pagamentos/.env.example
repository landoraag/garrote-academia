# Variáveis do servidor de pagamentos. Cadastre na Vercel (Settings > Environment Variables).
# NUNCA coloque os valores reais neste arquivo: o repositório é público.

# Mercado Pago (aplicação da academia > Credenciais). Comece com as de TESTE.
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
# Webhooks > Configurar notificações > Assinatura secreta
MP_WEBHOOK_SECRET=
# 1 = ambiente de teste (Pix aprovado sozinho, parcelas liberadas para teste). Em produção: 0
MP_MODO_TESTE=1

# Firebase do app OFICIAL (garrote-academia): conteúdo inteiro do JSON da conta de serviço
FIREBASE_SERVICE_ACCOUNT=

# Endereço(s) do app que podem chamar este servidor, separados por vírgula
APP_ORIGINS=https://garrote-academia.web.app,https://garrote-academia.firebaseapp.com
